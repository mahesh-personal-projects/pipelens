{
  "name": "pipelens",
  "displayName": "Pipelens",
  "description": "Live CI/CD pipeline view for GitHub Actions and GitLab CI, right in VS Code",
  "version": "0.1.0",
  "publisher": "pipelens",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["github actions", "gitlab ci", "pipeline", "ci/cd", "devops"],
  "icon": "resources/icon.png",
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pipelens.signInGitHub",
        "title": "Sign in to GitHub",
        "category": "Pipelens"
      },
      {
        "command": "pipelens.signInGitLab",
        "title": "Sign in to GitLab",
        "category": "Pipelens"
      },
      {
        "command": "pipelens.signOut",
        "title": "Sign Out",
        "category": "Pipelens"
      },
      {
        "command": "pipelens.refreshRepos",
        "title": "Refresh Repositories",
        "category": "Pipelens",
        "icon": "$(refresh)"
      },
      {
        "command": "pipelens.selectRepo",
        "title": "Select Repository",
        "category": "Pipelens"
      },
      {
        "command": "pipelens.openPipelineView",
        "title": "Open Pipeline View",
        "category": "Pipelens"
      },
      {
        "command": "pipelens.signInAzureDevOps",
        "title": "Sign in to Azure DevOps",
        "category": "Pipelens"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pipelens",
          "title": "Pipelens",
          "icon": "resources/pipelens.svg"
        }
      ]
    },
    "views": {
      "pipelens": [
        {
          "id": "pipelens.repoTree",
          "name": "Repositories"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "pipelens.refreshRepos",
          "when": "view == pipelens.repoTree",
          "group": "navigation"
        },
        {
          "command": "pipelens.signInGitHub",
          "when": "view == pipelens.repoTree",
          "group": "1_auth"
        },
        {
          "command": "pipelens.signInGitLab",
          "when": "view == pipelens.repoTree",
          "group": "1_auth"
        },
        {
          "command": "pipelens.signInAzureDevOps",
          "when": "view == pipelens.repoTree",
          "group": "1_auth"
        },
        {
          "command": "pipelens.signOut",
          "when": "view == pipelens.repoTree",
          "group": "1_auth"
        }
      ]
    },
    "configuration": {
      "title": "Pipelens",
      "properties": {
        "pipelens.pollIntervalSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "description": "How often to poll for pipeline updates when a pipeline is active (seconds)"
        },
        "pipelens.notifyOnComplete": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a watched pipeline completes"
        },
        "pipelens.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show the pipeline status item in the status bar"
        },
        "pipelens.gitlabBaseUrl": {
          "type": "string",
          "default": "https://gitlab.com",
          "description": "Base URL for GitLab — override for self-hosted instances (e.g. https://gitlab.mycompany.com)"
        },
        "pipelens.azureDevOpsOrgUrl": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps organization URL (e.g. https://dev.azure.com/myorganization). Set automatically on first sign-in."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production && vite build",
    "build:ext": "node esbuild.js",
    "build:webview": "vite build",
    "watch:ext": "node esbuild.js --watch",
    "watch:webview": "vite build --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.2.0",
    "esbuild": "^0.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
